.DS_Store
.claude/
!/claude/.claude/
# Chrome writes this next to an unpacked theme
*.pak
# Written by the atuin installer, not a setting
atuin/.config/atuin/atuin-receipt.json
# Pi credentials and local runtime state must never be versioned
pi/.pi/agent/auth.json
pi/.pi/agent/sessions/
pi/.pi/agent/models-store.json
pi/.pi/agent/install/
pi/.pi/agent/bin/
pi/.pi/agent/settings.json.*
