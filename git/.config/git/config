# Shared git settings tracked in dotfiles. Git reads this file in addition to
# ~/.gitconfig, which keeps identity and signing (machine-specific, untracked).

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	features = side-by-side-view
	navigate = true          # n / N jump between files in a diff
	line-numbers = true
	syntax-theme = Catppuccin Mocha
	# Catppuccin Mocha colors for added and removed lines
	plus-style = syntax "#2e363c"
	plus-emph-style = syntax "#445548"
	minus-style = syntax "#38313d"
	minus-emph-style = syntax "#5a3d50"
	line-numbers-plus-style = "#a6e3a1"
	line-numbers-minus-style = "#f38ba8"
	line-numbers-zero-style = "#585b70"
	file-style = "#89b4fa" bold
	file-decoration-style = "#89b4fa" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#585b70" box

# Separate feature so narrow views (lazygit) can turn it off with --features=
[delta "side-by-side-view"]
	side-by-side = true

[merge]
	conflictStyle = zdiff3
