#!/bin/bash
# Catppuccin Mocha palette, colors as 0xAARRGGBB.
#   active   blue #89b4fa
#   inactive transparent, only the focused window gets a ring

options=(
  style=round
  width=6.0
  hidpi=off
  order=above
  active_color=0xff89b4fa
  inactive_color=0x00000000
  background_color=0x00000000
)

borders "${options[@]}"
