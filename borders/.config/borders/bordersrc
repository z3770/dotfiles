#!/bin/bash
# Tokyo Night "night" palette, colors as 0xAARRGGBB.
#   active   blue #7aa2f7, same as the active tmux tab
#   inactive transparent, only the focused window gets a ring

options=(
  style=round
  width=6.0
  hidpi=off
  order=above
  active_color=0xff7aa2f7
  inactive_color=0x00000000
  background_color=0x00000000
)

borders "${options[@]}"
